# Server
PORT=3500
NODE_ENV=development

# Keycloak (solo se usa si se habilita el middleware en server/index.js)
KEYCLOAK_URL=https://auth.example.internal
KEYCLOAK_REALM=gateway
KEYCLOAK_CLIENT_ID=gateway-admin-spa

# Datos persistentes del panel: ambientes, archivos registrados, snapshots y backups.
# En produccion usa una ruta fuera del directorio de despliegue.
# Ejemplo Windows: DATA_DIR=C:\ProgramData\gateway-manager\data
DATA_DIR=./server/data

# CORS (solo desarrollo; en produccion el servidor entrega el frontend)
CLIENT_ORIGIN=http://localhost:5173
