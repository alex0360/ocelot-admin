# ── Server ──
PORT=3500
NODE_ENV=development

# ── Keycloak ──
KEYCLOAK_URL=https://auth.cws.local
KEYCLOAK_REALM=cws-gateway
KEYCLOAK_CLIENT_ID=gateway-admin-spa

# ── Data ──
# Directorio donde se guardan los metadatos del panel (ambientes, archivos registrados, snapshots)
# En producción usa una ruta fuera del directorio de despliegue para no perder datos al actualizar.
# Ejemplo Windows: DATA_DIR=C:\ProgramData\gateway-manager-cws\data
DATA_DIR=./server/data

# ── CORS (solo dev, en prod se sirve desde el mismo origin) ──
CLIENT_ORIGIN=http://localhost:5173
