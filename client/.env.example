# Configuracion del navegador (Vite).
# Copia este archivo como client/.env.local para reemplazar los valores locales.

# true permite iniciar sin Keycloak usando un usuario de desarrollo.
VITE_KEYCLOAK_DISABLED=true

# Requerido solo con VITE_KEYCLOAK_DISABLED=false.
# VITE_KEYCLOAK_URL=https://auth.example.internal
# VITE_KEYCLOAK_REALM=gateway
# VITE_KEYCLOAK_CLIENT_ID=gateway-admin-spa
