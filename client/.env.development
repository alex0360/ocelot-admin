# En desarrollo se puede deshabilitar Keycloak para trabajar sin un servidor de autenticacion.
VITE_KEYCLOAK_DISABLED=true

# Para usar Keycloak, cambia a false y completa los valores en client/.env.local.
# VITE_KEYCLOAK_URL=https://auth.example.internal
# VITE_KEYCLOAK_REALM=gateway
# VITE_KEYCLOAK_CLIENT_ID=gateway-admin-spa
